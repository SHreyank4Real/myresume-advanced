# Redis — prefer REDIS_URL in Docker / Kubernetes
# Examples:
#   Local (compose):     redis://127.0.0.1:6379/0
#   Docker network:      redis://redis:6379/0
#   Kubernetes Service:  redis://redis.resume.svc.cluster.local:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# Or split form (used when REDIS_URL is empty) — typical K8s ConfigMap + Secret
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# App
NODE_ENV=development
PORT=3000
